{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Iniciar presentación",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\iniciar.ps1\"",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Pruebas (pytest)",
      "type": "shell",
      "command": "${workspaceFolder}\.venv\Scripts\python.exe -m pytest -v",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test"
    }
  ]
}
